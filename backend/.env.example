# You generate this token yourself — there's nothing to find.
# Make up any long random string, or generate one:
#   openssl rand -hex 32
#
# Paste the SAME string into:
#   1. This file (backend.env)
#   2. The watch app's setup page, under "Bearer token"
#
# The watch sends it as `Authorization: Bearer <token>`; the backend
# rejects any request without a matching token.
HERMES_WATCH_TOKEN=change-me-to-a-long-random-string
