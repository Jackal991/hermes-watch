[Unit]
Description=Hermes Watch backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/hermes-watch/backend
ExecStart=%h/apps/hermes-watch/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8650
EnvironmentFile=%h/apps/hermes-watch/backend/backend.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
